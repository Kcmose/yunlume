# yunlume 宿主机运行环境；安装器会替换双下划线占位符。
TZ=Asia/Hong_Kong
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18081
CACHE_TYPE=redis
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8"

# 安全与公开访问
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRATION_MINUTES=120
OPENAPI_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:__APP_PORT__,http://127.0.0.1:__APP_PORT__
NAV_BOOTSTRAP_ENABLED=false
NAV_DEMO_DATA_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 首次安装默认从网页向导接入外部 PostgreSQL；凭据只允许经可信反代 HTTPS 提交。
NAV_WEB_INSTALL_ENABLED=true
NAV_DATABASE_SOURCE=UNCONFIGURED
NAV_DATABASE_CONFIG_FILE=/var/lib/yunlume/config/database.properties
NAV_DATABASE_CONFIGURED_MARKER_FILE=/var/lib/yunlume/config/database.configured
NAV_INSTALL_COMPLETED_MARKER_FILE=/var/lib/yunlume/config/install.completed
NAV_DATABASE_CA_FILE=/var/lib/yunlume/config/postgresql-ca.pem
NAV_DATABASE_TICKET_TTL_SECONDS=300
NAV_DATABASE_AUTO_RESTART=true
NAV_ALLOW_INSECURE_DATABASE_SETUP=false
NAV_TRUST_FORWARDED_HTTPS=true
NAV_TRUSTED_PROXY_PEERS=127.0.0.1,::1
DB_URL=jdbc:postgresql://database.invalid:5432/unconfigured
DB_USERNAME=unconfigured
DB_PASSWORD=
DB_POOL_SIZE=10

# 首次安装默认从网页向导接入外部 Redis。
NAV_REDIS_SOURCE=UNCONFIGURED
NAV_REDIS_CONFIG_FILE=/var/lib/yunlume/config/redis.properties
NAV_REDIS_CONFIGURED_MARKER_FILE=/var/lib/yunlume/config/redis.configured
NAV_REDIS_CA_FILE=/var/lib/yunlume/config/redis-ca.pem
NAV_REDIS_TICKET_TTL_SECONDS=300
NAV_REDIS_AUTO_RESTART=true
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=3s
REDIS_READ_TIMEOUT=3s

# 用户上传与安装持久化数据固定在 /var/lib/yunlume。
APP_UPLOAD_DIR=/var/lib/yunlume/uploads
UPLOAD_DIR=/var/lib/yunlume/uploads
APP_UPLOAD_BASE_URL=/uploads
APP_UPLOAD_MAX_BYTES=10485760
APP_UPLOAD_MAX_TOTAL_BYTES=1073741824
APP_UPLOAD_MAX_FILES=500
APP_UPLOAD_ORPHAN_GRACE_MS=86400000
APP_UPLOAD_CLEANUP_INTERVAL_MS=21600000
APP_UPLOAD_CLEANUP_INITIAL_DELAY_MS=60000

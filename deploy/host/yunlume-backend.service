[Unit]
Description=yunlume backend service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=yunlume
Group=yunlume
EnvironmentFile=/etc/yunlume/app.env
WorkingDirectory=__INSTALL_DIR__/current
ExecStart=__JAVA_BIN__ -jar __INSTALL_DIR__/current/backend/yunlume-backend.jar
Restart=always
RestartSec=5s
SuccessExitStatus=143
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0022
LimitNOFILE=65536

# 程序与系统目录只读，仅允许写入持久化数据目录。
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yunlume

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yunlume-backend

[Install]
WantedBy=multi-user.target

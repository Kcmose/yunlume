# 对外访问端口与时区
APP_PORT=8080
TZ=Asia/Hong_Kong

# frontend 容器直连时保持默认值。放在 1Panel OpenResty 等 HTTPS 代理后时，先把 APP_BIND_ADDRESS
# 改为宿主机明确的 loopback/私网地址并用防火墙阻止客户端绕过代理，再只信任 frontend 访问日志中
# 看到的即时代理源 IP（或最窄的隔离代理网段）。禁止使用 0.0.0.0/0 或 ::/0。
APP_BIND_ADDRESS=0.0.0.0
WEB_TRUST_PROXY_HEADERS=false
WEB_TRUSTED_PROXY_CIDR=127.0.0.1/32

# 数据库只支持外部 PostgreSQL。请先在 1Panel/数据库服务商创建空白专用数据库和非 superuser
# 业务用户，再通过首次安装向导填写连接信息；网页里的管理员是站点管理员，数据库密码不要写入此文件。
# 新部署保持 UNCONFIGURED；安装成功后连接信息保存在 database_config 卷。
NAV_DATABASE_SOURCE=UNCONFIGURED
# fresh install 默认允许通过当前公网 HTTP 入口提交 PostgreSQL/Redis 凭据；传输内容不会由应用层加密。
NAV_ALLOW_INSECURE_DATABASE_SETUP=true
NAV_DATABASE_TICKET_TTL_SECONDS=300
NAV_DATABASE_AUTO_RESTART=true

# 可选：隔离恢复或回滚时切换到新的命名卷，默认值与正式环境固定名称一致
UPLOADS_VOLUME_NAME=yunlume_uploads_data
LOGS_VOLUME_NAME=yunlume_backend_logs
DATABASE_CONFIG_VOLUME_NAME=yunlume_database_config

# 可选：固定或回滚 frontend/后端镜像；保留 build 配置时也可由 Compose 重新构建
BACKEND_IMAGE=yunlume-backend:latest
FRONTEND_IMAGE=yunlume-frontend:latest

# Redis 只连接外部服务，不由本项目创建容器或数据卷。新部署通过安装向导测试并保存
# 连接，密码不会写入 .env；安装成功后配置保存在 database_config 卷。
NAV_REDIS_SOURCE=UNCONFIGURED
NAV_REDIS_TICKET_TTL_SECONDS=300
NAV_REDIS_AUTO_RESTART=true

# 仅供从旧版本升级的 LEGACY_ENV 部署兼容。新部署保持以上 UNCONFIGURED，下面各项留空。
# 公网或跨主机的旧配置默认使用 TLS；只有受信任私网才显式设为 false。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=3s
REDIS_READ_TIMEOUT=3s

# JWT 至少使用 32 字节随机字符串；建议通过密码管理器生成
JWT_SECRET=
# 修改 APP_PORT 时，请同步调整下方允许跨域来源的端口
JWT_EXPIRATION_MINUTES=120
# 生产环境默认关闭 Swagger/OpenAPI；仅在受控环境临时开启
OPENAPI_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 新部署默认使用网页安装向导；确认空库后由后端打包的权威 schema 完成初始化
NAV_BOOTSTRAP_ENABLED=false
NAV_DEMO_DATA_ENABLED=false
# 网页安装入口；持久化完成状态用于防止重复初始化。
NAV_WEB_INSTALL_ENABLED=true
# 仅当 NAV_BOOTSTRAP_ENABLED=true 时使用的传统环境变量引导方式
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 前端生产构建使用同源 API 地址
VITE_API_BASE_URL=/api

# 后台上传背景图的单文件大小上限（字节，默认 10MB）
APP_UPLOAD_MAX_BYTES=10485760
# 背景图片存储总量、文件数以及孤儿文件回收策略
APP_UPLOAD_MAX_TOTAL_BYTES=1073741824
APP_UPLOAD_MAX_FILES=500
APP_UPLOAD_ORPHAN_GRACE_MS=86400000
APP_UPLOAD_CLEANUP_INTERVAL_MS=21600000
APP_UPLOAD_CLEANUP_INITIAL_DELAY_MS=60000

# 可选 JVM 参数
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
